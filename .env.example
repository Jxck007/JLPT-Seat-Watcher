NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=
# Optional override for config.yaml: WATCHTOWER_ADAPTER=jlpt_chennai
# Optional override for config.yaml: NOTIFICATION_PROVIDER=ntfy
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TO=
# Optional override for config.yaml, for example: WATCHED_LEVELS=N4,N2
# Optional session override: WATCHED_SESSION=Auto|Forenoon|Afternoon|Both
TIMEZONE=Asia/Kolkata
CHECK_INTERVAL=300
HEARTBEAT_INTERVAL=3600
URGENT_INTERVAL=600
LOG_LEVEL=INFO
SCRAPER_TIMEOUT=30
MAX_RETRIES=3
ENABLE_SCREENSHOT=true
ENABLE_PLAYWRIGHT=true
ENABLE_DAILY_SUMMARY=true
DAILY_SUMMARY_HOUR=20
LOG_RETENTION_DAYS=30
HISTORY_RETENTION_DAYS=30
